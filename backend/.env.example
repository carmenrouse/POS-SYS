DATABASE_URL="postgresql://postgres:postgres@localhost:5432/po_sync?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
PORT=4000

# OCR adapter: "mock" (no external calls, for local dev) | "textract" | "documentai"
OCR_PROVIDER="mock"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
GOOGLE_DOCUMENT_AI_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION=""
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Square sandbox (https://developer.squareup.com/apps -> sandbox credentials)
SQUARE_ENV="sandbox"
SQUARE_APPLICATION_ID=""
SQUARE_APPLICATION_SECRET=""
