generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ImportSourceType {
  CSV
  XLSX
  SCAN_IMAGE
  SCAN_PDF
}

enum ImportJobStatus {
  PROCESSING
  NEEDS_REVIEW
  APPROVED
  PUSHED
  PARTIALLY_PUSHED
  FAILED
}

enum RowValidationStatus {
  CLEAN
  NEEDS_REVIEW
  ERROR
}

enum POSPlatform {
  SQUARE
  CLOVER
  SHOPIFY
  LIGHTSPEED
}

enum POSConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

enum PushAction {
  CREATE_PRODUCT
  UPDATE_INVENTORY
}

model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  suppliers             Supplier[]
  supplierFieldMappings SupplierFieldMapping[]
  importJobs            ImportJob[]
  products              Product[]
  posConnections        POSConnection[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  importJobsCreated  ImportJob[] @relation("ImportJobCreatedBy")
  importJobsApproved ImportJob[] @relation("ImportJobApprovedBy")
  pushLogs           PushLog[]

  @@unique([businessId, email])
  @@index([businessId])
}

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fieldMapping SupplierFieldMapping?
  importJobs   ImportJob[]

  @@index([businessId])
}

// Saved column-mapping profile for a supplier, so repeat imports auto-map.
// { "<incoming CSV header>": "<internal field name>" }
model SupplierFieldMapping {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  mapping    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model ImportJob {
  id              String              @id @default(cuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  posConnectionId String?
  posConnection   POSConnection?      @relation(fields: [posConnectionId], references: [id])
  sourceType      ImportSourceType
  originalFileUrl String?
  originalFileName String?
  status          ImportJobStatus     @default(PROCESSING)
  columnMapping   Json?
  rawFileData     Json?
  rawOcrData      Json?
  failureReason   String?
  createdById     String
  createdBy       User                @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?               @relation("ImportJobApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  pushedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  rows     ImportRow[]
  pushLogs PushLog[]

  @@index([businessId])
  @@index([businessId, status])
}

model ImportRow {
  id                String              @id @default(cuid())
  importJobId       String
  importJob         ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowIndex          Int
  rawData           Json
  mappedData        Json
  validationStatus  RowValidationStatus @default(NEEDS_REVIEW)
  validationMessages String[]           @default([])
  confidence        Float?
  matchedProductId  String?
  matchedProduct    Product?            @relation(fields: [matchedProductId], references: [id])
  approved          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  pushLogs PushLog[]

  @@index([importJobId])
  @@index([importJobId, validationStatus])
}

// Cached/synced representation of what's in the connected POS — not the source of truth.
model Product {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  posConnectionId String?
  posConnection   POSConnection? @relation(fields: [posConnectionId], references: [id])
  externalId      String?
  sku             String
  name            String
  description     String?
  cost            Decimal        @default(0) @db.Decimal(10, 2)
  price           Decimal        @default(0) @db.Decimal(10, 2)
  quantityOnHand  Int            @default(0)
  category        String?
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  importRows ImportRow[]

  @@unique([businessId, sku])
  @@index([businessId])
}

model POSConnection {
  id              String               @id @default(cuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform        POSPlatform
  status          POSConnectionStatus  @default(NOT_CONNECTED)
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  externalLocationId String?
  config          Json?
  lastError       String?
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  importJobs ImportJob[]
  products   Product[]
  pushLogs   PushLog[]

  @@unique([businessId, platform])
  @@index([businessId])
}

// Full audit trail of what was sent to a POS API, when, and the result.
model PushLog {
  id              String         @id @default(cuid())
  importJobId     String
  importJob       ImportJob      @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importRowId     String?
  importRow       ImportRow?     @relation(fields: [importRowId], references: [id])
  posConnectionId String
  posConnection   POSConnection  @relation(fields: [posConnectionId], references: [id])
  action          PushAction
  requestPayload  Json
  responsePayload Json?
  success         Boolean
  errorMessage    String?
  pushedById      String
  pushedBy        User           @relation(fields: [pushedById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([importJobId])
  @@index([posConnectionId])
}
